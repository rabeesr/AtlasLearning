# Supabase — find these in your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_REVIEWS_RPC_SECRET=replace_with_review_rpc_secret

# Clerk — find these in the Clerk dashboard for your application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Optional Clerk URL overrides (defaults are fine)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Ask Atlas tutor — required for the global learning companion
# Groq: hosts the chat LLM (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Voyage: embeddings for the retrieval corpus
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxx
# Supabase service role — bypasses RLS for the corpus write + tutor queries.
# Server-side only; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
